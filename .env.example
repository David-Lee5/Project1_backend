# ASP.NET Core environment variables (export them or use your process manager).
# The application does not automatically load .env files.
# Docker Compose SQL Server only (copy securely to .env or export before compose up).
MSSQL_SA_PASSWORD=
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5107
# Set securely; do not commit actual passwords or signing keys.
ConnectionStrings__DefaultConnection=
JwtSettings__SecretKey=
JwtSettings__Issuer=RepairSystem
JwtSettings__Audience=RepairSystem.Client
JwtSettings__ExpirationMinutes=15
# Optional: creates the first administrator only when no admin account exists.
# Use at least 12 characters. Existing administrator credentials are never reset.
Bootstrap__AdminPassword=
# Optional allowed frontend origin; add numbered entries for additional origins.
Cors__AllowedOrigins__0=http://localhost:5173
