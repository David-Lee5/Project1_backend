# Tham khảo tên biến môi trường mà ASP.NET Core thực sự đọc.
# Ứng dụng KHÔNG tự đọc file .env; đặt biến trong PowerShell hoặc cấu hình Visual Studio.
# Với profile http (Development), chỉ cần sửa SQL Server instance nếu máy không dùng Server=.

ConnectionStrings__DefaultConnection=Server=.\SQLEXPRESS;Database=QLSCTBDT_V3;Trusted_Connection=True;TrustServerCertificate=True

# Chỉ cần đặt khi triển khai ngoài Development. Tạo khóa riêng, tối thiểu 32 byte.
JwtSettings__SecretKey=replace-with-a-private-random-key-at-least-32-bytes

# Tùy chọn: mật khẩu admin riêng khi khởi tạo CSDL lần đầu (tối thiểu 12 ký tự).
# BootstrapAdmin__Password=replace-with-a-private-admin-password
